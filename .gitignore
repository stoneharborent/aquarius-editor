# ── Private workspace (ignored since 2026-07-18) ──────────────
# AI assistant project rules, session configuration, skills, and hooks
# CLAUDE.md is tracked in this fork — it is the project law (unignored vs upstream)
AGENTS.md
.codex/
.agents/
.claude/
# Impeccable design-hook state and configuration
.impeccable/
.browser4-cli/
# Private working documents such as TODOs and design notes; publishable docs belong elsewhere
# (written as docs/* so the exception below can apply — git cannot re-include a file from
# inside an excluded directory).
docs/*
# …except the shortcut map, which CLAUDE.md rule 4 makes the law for keyboard bindings.
!docs/fcp-shortcut-map.md
# Local model-optimization plan / notes (was mistakenly committed; keep out of the public repo)
MODEL-OPT-PLAN.md
/MODEL-OPT-PLAN*/
*.opt-plan.md

# Keep local and temporary check scripts out of the repository; stable regressions use *.verify.* via npm test.
*.check.ts
*.check.mjs
# Keep the external MCP bridge protocol regression with its implementation; the legacy name is intentional.
!server/external-agent/broker.check.ts

# Local development and verification scripts.
# `/scripts/*`, not `/scripts/` — git cannot re-include a file whose parent directory is
# excluded, so the `!` lines below only take effect when the entries are listed individually.
/scripts/*
!/scripts/sync-mediapipe.mjs
# Builds the shipped assets/luts/*.cube conversion LUTs; src/gl/fx/conversion-luts.verify.ts
# re-runs it and diffs, so it has to travel with the repo.
!/scripts/generate-conversion-luts.mjs

# Local marketing assets and drafts
/marketing/
.pi-*
node_modules
public/mediapipe/
public/whisper-cli/


# Local npm cache
.npm-cache/
# Root-level local runtime files
/etc/
node_modules.nosync/
